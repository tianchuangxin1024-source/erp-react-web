# Include from nginx's http {} context, normally /etc/nginx/conf.d/*.conf.
# Preserve unknown Origin values so the backend can reject foreign writes.
map $http_origin $erp_web_upstream_origin {
    default $http_origin;
    "" "";
    "@PUBLIC_ORIGIN@" "@BACKEND_ORIGIN@";
}

server {
    listen @LISTEN_PORT@;
    server_name @SERVER_NAME@;
    root @WEB_ROOT@/current;
    index index.html;

    client_max_body_size 11m;
    add_header X-Content-Type-Options nosniff always;

    location = /api {
        return 308 /api/;
    }

    location ^~ /api/ {
        # No trailing slash, so /api remains part of the upstream URI.
        proxy_pass @BACKEND_ORIGIN@;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Origin $erp_web_upstream_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $proxy_host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Port @BACKEND_PORT@;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
